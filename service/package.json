{
  "name": "@randy.tarampi/service",
  "description": "The backend for www.randytarampi.ca",
  "version": "8.0.0",
  "author": {
    "name": "Randy Tarampi",
    "email": "rt@randytarampi.ca",
    "url": "https://www.randytarampi.ca"
  },
  "bugs": "https://github.com/randytarampi/me/issues",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1081.0",
    "@aws-sdk/client-ssm": "^3.1081.0",
    "@octokit/rest": "^22.0.1",
    "@randy.tarampi/js": "workspace:*",
    "@randy.tarampi/lambda-logger": "workspace:*",
    "@randy.tarampi/serverless": "workspace:*",
    "config": "^5.0.0-alpha.2",
    "dynamoose": "^4.2.0",
    "flickr-sdk": "^7.1.0",
    "form-data": "^4.0.6",
    "immutable": "^5.1.9",
    "js-yaml": "^5.2.1",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "mime-types": "^3.0.2",
    "query-string": "^9.4.1",
    "rss": "^1.2.2",
    "tumblr.js": "^5.0.1",
    "unsplash-js": "^8.0.0"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "esmock": "^2.7.6",
    "gulp": "^5.0.1",
    "mocha-junit-reporter": "^2.2.1",
    "nyc": "^18.0.0",
    "serverless": "^4.38.1",
    "serverless-domain-manager": "^10.2.0",
    "serverless-offline": "^14.7.4",
    "serverless-plugin-warmup": "^8.4.1",
    "serverless-secrets": "github:RishitKedia/serverless-secrets#fix-get-parameters-limit-of-10",
    "sinon": "^22.0.0"
  },
  "directories": {
    "lib": "./src/lib",
    "test": "./test"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "service",
    "type": "git",
    "url": "https://github.com/randytarampi/me.git"
  },
  "scripts": {
    "clean": "gulp -LLLL --color clean",
    "cover": "yarn run pretest:localstack && cross-env-shell NODE_ENV=test nyc gulp -LLLL --color test && yarn run kill:localstack",
    "deploy": "if [ -z \"$NODE_ENV\" ]; then cross-env-shell NODE_ENV=dev yarn run deploy; else yarn run deploy:$NODE_ENV; fi; ",
    "deploy:dev": "sls create_domain --stage $NODE_ENV --region us-east-1 && sls deploy --conceal --stage $NODE_ENV --region us-east-1",
    "deploy:prd": "sls create_domain --stage $NODE_ENV --region ca-central-1 && sls deploy --conceal --stage $NODE_ENV --region ca-central-1",
    "dev": "yarn run dev:serverless",
    "dev:serverless": "cross-env-shell NODE_ENV=development sls offline start",
    "kill": "yarn run kill:localstack",
    "kill:localstack": "bash -c 'docker rm --force me-service-localstack >/dev/null 2>&1 || true'",
    "localstack:migrate": "node src/serverless/dynamodb/migrate.js",
    "localstack:start": "bash -c 'if curl --fail --silent --show-error http://localhost:4566/_localstack/health >/dev/null 2>&1; then echo \"LocalStack is already listening on :4566\"; else docker run --detach --rm --name me-service-localstack --publish 4566:4566 --env SERVICES=dynamodb localstack/localstack:4; fi'",
    "poststart": "yarn run kill",
    "posttest": "yarn run kill",
    "prestart": "yarn run kill",
    "pretest": "gulp -LLLL --color lint",
    "pretest:localstack": "yarn run localstack:start && yarn run localstack:migrate",
    "start": "yarn run dev",
    "test": "yarn run pretest:localstack && yarn run test:actual",
    "test:actual": "cross-env-shell NODE_ENV=test gulp -LLLL --color test"
  }
}
