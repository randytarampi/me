{
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["{projectRoot}/src/**", "{projectRoot}/package.json", "{projectRoot}/*.config.js"],
      "outputs": ["{projectRoot}/dist/", "{projectRoot}/esm/"]
    },
    "lint": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["{projectRoot}/src/**", "{projectRoot}/test/**", "{projectRoot}/eslint.config.js", "{projectRoot}/package.json"],
      "outputs": []
    },
    "pretest": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["{projectRoot}/src/**", "{projectRoot}/test/**", "{projectRoot}/eslint.config.js", "{projectRoot}/package.json"],
      "outputs": ["{projectRoot}/eslint-results.xml"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "inputs": ["{projectRoot}/src/**", "{projectRoot}/test/**", "{projectRoot}/package.json"],
      "outputs": ["{projectRoot}/test-results.xml", "{projectRoot}/.nyc_output/"]
    },
    "cover": {
      "dependsOn": ["^build", "build"],
      "inputs": ["{projectRoot}/src/**", "{projectRoot}/test/**", "{projectRoot}/package.json"],
      "outputs": ["{projectRoot}/coverage/", "{projectRoot}/.nyc_output/"]
    },
    "job-application": {
      "dependsOn": ["^build", "build"],
      "inputs": ["{projectRoot}/src/**", "{projectRoot}/package.json"],
      "outputs": ["{projectRoot}/dist/"]
    },
    "job-applications": {
      "dependsOn": ["^build", "build"],
      "inputs": ["{projectRoot}/src/**", "{projectRoot}/package.json"],
      "outputs": ["{projectRoot}/dist/"]
    },
    "docs": {
      "dependsOn": ["^build", "build"],
      "inputs": ["{projectRoot}/dist/**", "{projectRoot}/package.json"],
      "outputs": ["{projectRoot}/docs/"]
    },
    "resume": {
      "dependsOn": ["^build", "build"],
      "inputs": ["{projectRoot}/src/**", "{projectRoot}/package.json"],
      "outputs": ["{projectRoot}/dist/"]
    },
    "letter": {
      "dependsOn": ["^build", "build"],
      "inputs": ["{projectRoot}/src/**", "{projectRoot}/package.json"],
      "outputs": ["{projectRoot}/dist/"]
    },
    "start": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"]
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [],
    "exclude": [
      "{projectRoot}/.eslintrc.json",
      "{projectRoot}/eslint.config.js",
      "{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "{projectRoot}/tsconfig.spec.json",
      "{projectRoot}/jest.config.[jt]s",
      "{projectRoot}/**/*.spec.[jt]s",
      "{projectRoot}/test/**/*"
    ]
  }
}
