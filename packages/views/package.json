{
  "name": "@randy.tarampi/views",
  "description": "Some common Pug templates for www.randytarampi.ca",
  "version": "8.0.0",
  "author": {
    "name": "Randy Tarampi",
    "email": "rt@randytarampi.ca",
    "url": "https://www.randytarampi.ca"
  },
  "bugs": "https://github.com/randytarampi/me/issues",
  "dependencies": {
    "@randy.tarampi/js": "workspace:*",
    "config": "^5.0.1"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "cross-env": "^10.1.0",
    "gulp": "^5.0.1",
    "gulp-pug": "^5.0.0"
  },
  "directories": {
    "lib": "./src/lib"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "esm",
    "npm-shrinkwrap.json",
    "templates"
  ],
  "homepage": "https://www.randytarampi.ca",
  "license": "MIT",
  "main": "./esm/index.js",
  "module": "./esm/index.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/views",
    "type": "git",
    "url": "https://github.com/randytarampi/me.git"
  },
  "scripts": {
    "build": "yarn run build:gulp && yarn run build:babel",
    "build:babel": "yarn run build:babel:esm",
    "build:babel:esm": "cross-env-shell BABEL_ENV=client.esm BABEL_ESM_STANDALONE_BUILD=true babel src --out-dir esm --root-mode upward --copy-files",
    "build:gulp": "gulp -LLLL --color build",
    "clean": "gulp -LLLL --color clean",
    "prepack": "bash -c 'if [ ! -d \"./dist\" ] && [ ! -d \"./esm\" ]; then exit 74; fi;'",
    "prepare": "yarn run build",
    "pretest": "gulp -LLLL --color lint"
  },
  "sideEffects": false,
  "type": "module"
}
