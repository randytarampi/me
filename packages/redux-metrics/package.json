{
  "name": "@randy.tarampi/redux-metrics",
  "type": "module",
  "description": "A client-side-logger for www.randytarampi.ca",
  "version": "8.0.0",
  "author": {
    "name": "Randy Tarampi",
    "email": "rt@randytarampi.ca",
    "url": "https://www.randytarampi.ca"
  },
  "bugs": "https://github.com/randytarampi/me/issues",
  "dependencies": {
    "luxon": "^3.7.2",
    "react-metrics": "^2.4.1"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "gulp": "^5.0.1",
    "jsdom": "^29.1.1",
    "mocha-junit-reporter": "^2.2.1",
    "sinon": "^22.0.0"
  },
  "directories": {
    "lib": "./src/lib",
    "test": "./test"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "esm",
    "npm-shrinkwrap.json"
  ],
  "keywords": [
    "gtm",
    "metrics",
    "react-metrics",
    "redux"
  ],
  "license": "MIT",
  "main": "./esm/index.js",
  "module": "./esm/index.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/redux-metrics",
    "type": "git",
    "url": "https://github.com/randytarampi/me.git"
  },
  "scripts": {
    "build": "yarn run build:babel",
    "build:babel": "yarn run build:babel:esm",
    "build:babel:esm": "cross-env-shell BABEL_ENV=client.esm babel src --out-dir esm --root-mode upward --copy-files --keep-file-extension",
    "clean": "gulp -LLLL --color clean",
    "cover": "cross-env-shell NODE_ENV=test nyc gulp -LLLL --color test",
    "dev": "yarn run dev:client",
    "dev:client": "yarn run predev:client && cross-env-shell NODE_ENV=development webpack serve --config ./webpack.client.config.js --hot",
    "predev:client": "rm -rf dist/*.js dist/*.css || true",
    "prepack": "if [ ! -d \"./dist\" ] && [ ! -d \"./esm\" ]; then exit 74; fi;",
    "prepare": "yarn run build",
    "pretest": "gulp -LLLL --color lint",
    "preuninstall": "yarn run clean",
    "start": "yarn run dev",
    "test": "cross-env-shell NODE_ENV=test gulp -LLLL --color test"
  },
  "sideEffects": false
}
