{
  "name": "@randy.tarampi/lambda-logger",
  "type": "module",
  "description": "Just my opinionated logger for my AWS Lambda functions",
  "version": "8.0.0",
  "author": {
    "name": "Randy Tarampi",
    "email": "rt@randytarampi.ca",
    "url": "https://www.randytarampi.ca"
  },
  "bugs": "https://github.com/randytarampi/me/issues",
  "dependencies": {
    "@sentry/node": "^9.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "gulp": "^5.0.1",
    "mocha-junit-reporter": "^2.2.1",
    "sinon": "^22.0.0"
  },
  "directories": {
    "lib": "./src/lib",
    "test": "./test"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "esm",
    "npm-shrinkwrap.json"
  ],
  "keywords": [
    "logger",
    "pino",
    "sentry"
  ],
  "license": "MIT",
  "main": "./esm/index.js",
  "module": "./esm/index.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/lambda-logger",
    "type": "git",
    "url": "https://github.com/randytarampi/me.git"
  },
  "scripts": {
    "build": "yarn run build:babel",
    "build:babel": "yarn run build:babel:esm",
    "build:babel:esm": "cross-env-shell BABEL_ENV=client.esm BABEL_ESM_STANDALONE_BUILD=true babel src --out-dir esm --root-mode upward --copy-files",
    "clean": "gulp -LLLL --color clean",
    "cover": "cross-env-shell NODE_ENV=test nyc gulp -LLLL --color test",
    "prepack": "if [ ! -d \"./dist\" ] && [ ! -d \"./esm\" ]; then exit 74; fi;",
    "prepare": "yarn run build",
    "pretest": "gulp -LLLL --color lint",
    "start": "yarn run dev",
    "test": "cross-env-shell NODE_ENV=test gulp -LLLL --color test"
  }
}
