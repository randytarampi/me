build/Release

# Dependency directories
node_modules
jspm_packages

# npm and yarn directories
.npm
# NOTE-RT: negate `.yarn` itself first — a global `~/.gitignore` `.yarn` rule otherwise excludes
# this whole tree and defeats every negation below.
!.yarn/
.yarn/*
!.yarn/releases
!.yarn/plugins
!.yarn/patches
!.yarn/patches/**
.pnp.*

# Optional REPL history
.node_repl_history

# OS files
.DS_Store

# Generated
## Node
.nyc_output/
*.log

## Testing
test-results.xml

## JetBrains
*.iml
.idea/

## Lerna
lerna-debug.log

# Compiled resources
dist
build
es5
esm
.webpack
*.pdf_original

# Except the headless bundle smoke test, which lives in a directory named `dist` on purpose
!www/test/integration/dist/
!www/test/integration/dist/**

# Environment variables
.env

# Serverless
.serverless

# Secrets
.secrets.*.yml

# Local configuration
config/local.cjs

# Test result reports
pretest-results.xml
eslint-results.xml

# Written resources
packages/service/posts
service/posts

# Deepwork progress (not committed)
.slim/deepwork/

.nx/

# NOTE-RT: generated by `yarn lerna run docs --scope @randy.tarampi/www` (dist/** + CNAME).
