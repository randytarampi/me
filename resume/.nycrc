{
  "exclude": [
    "node_modules/**",
    "dist/**",
    "build/**",
    "es5/**",
    "esm/**",
    "docs/**",
    "coverage/**",
    "src/resumes/**",
    "src/resume-custom-content/**",
    ".nyc_output/**",
    "test/**",
    "*.js"
  ],
  "reporter": [
    "text-summary",
    "lcov"
  ],
  "cache": true,
  "all": true,
  "check-coverage": false,
  "sourceMap": false,
  "instrument": false,
  "watermarks": {
    "lines": [
      70,
      90
    ],
    "functions": [
      70,
      90
    ],
    "branches": [
      70,
      90
    ],
    "statements": [
      70,
      90
    ]
  }
}
