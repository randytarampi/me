{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/*": {
      "entry": ["package.json"],
      "ignore": [
        "coverage/**",
        ".nyc_output/**",
        "dist/**",
        "build/**",
        "packages/*/coverage/**",
        "packages/*/.nyc_output/**",
        "packages/*/dist/**",
        "packages/*/build/**",
        "packages/*/test/**",
        "packages/*/tests/**"
      ]
    },
    "service": {
      "entry": ["package.json"],
      "ignore": [
        "coverage/**",
        ".nyc_output/**",
        "dist/**",
        "build/**",
        "test/**"
      ]
    },
    "www": {
      "entry": ["package.json"],
      "ignore": [
        "coverage/**",
        ".nyc_output/**",
        "dist/**",
        "build/**",
        "test/**"
      ]
    },
    "resume": {
      "entry": ["package.json"],
      "ignore": [
        "coverage/**",
        ".nyc_output/**",
        "dist/**",
        "build/**",
        "test/**"
      ]
    },
    "letter": {
      "entry": ["package.json"],
      "ignore": [
        "coverage/**",
        ".nyc_output/**",
        "dist/**",
        "build/**",
        "test/**"
      ]
    },
    "infrastructure": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}